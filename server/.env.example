# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/portfolio
# Optional: public DNS for SRV lookups if your network/VPN blocks them
# (fixes "querySrv ECONNREFUSED"). Example: 8.8.8.8,8.8.4.4
DNS_SERVERS=

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Public site URL (used in sitemap.xml and robots.txt)
SITE_URL=https://tauhidul.me

# Admin (used by seed script)
ADMIN_NAME=Tauhidul Islam
ADMIN_EMAIL=admin@tofeeuq.dev
ADMIN_PASSWORD=ChangeMe123!

# GitHub widget (optional token raises rate limits)
GITHUB_USERNAME=tofeeuqSoft
GITHUB_TOKEN=

# Email notifications (optional in dev; skipped if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_RECEIVER=admin@tofeeuq.dev
